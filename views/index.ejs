<!-- index.ejs -->
<html>
<head>
    <!-- Directly using the 'title' variable -->
    <title><%= title %></title> 
</head>
  <body>
    <% messages.forEach((message, index) => { %>
    <h2> <%= message.messagetext%></h2>
    <p>User: <%= message.messageuser %></p>
    <p> <%= message.added %> </p>
    <br>
    <a href="/message/<%= index %>">Open</a>
    <% }); %>
    
  </body>
</html>
